	"version": "0.2.0",
	"configurations": [
		{
			"name": "WayaGram",
			"request": "launch",
			"type": "dart"
		},
		{
			"name": "WayaGram (profile mode)",
			"request": "launch",
			"type": "dart",
			"flutterMode": "profile"
		},
		{
			"name": "WayaGram (release mode)",
			"request": "launch",
			"type": "dart",
			"flutterMode": "release"
		},
		{
			"name": "Run Flutter Gen (macOS and Linux)",
			"request": "launch",
			"command": "${workspaceFolder}/helpers/build.sh",
			"type": "node-terminal"
		},
		{
			"name": "Run Flutter Gen (Windows)",
			"request": "launch",
			"command": "${workspaceFolder}/helpers/build.bat",
			"type": "node-terminal"
		}
	]
}